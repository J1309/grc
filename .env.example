# Convex Real-Time Cloud Database
# IMPORTANT: In Vite & Vercel, client environment variables MUST start with "VITE_"
# Set this to your Convex deployment URL (e.g. from npx convex dev or Convex dashboard)
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
CONVEX_URL=https://your-deployment-name.convex.cloud

# Clerk Authentication (GroceryCart Customer Accounts)
# Obtain your key from https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
